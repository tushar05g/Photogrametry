# ============================================================================
# PHOTOGRAMMETRY PIPELINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env with real credentials to version control!
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL (Production) or SQLite (Development)
# Production example: postgresql://user:password@hostname:5432/dbname?sslmode=require
# Development example: sqlite:///./photogrammetry.db
DATABASE_URL=sqlite:///./photogrammetry.db

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Local development: redis://localhost:6379/0
# Remote production: redis://:password@hostname:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# Storage type: local, s3, cloudinary
STORAGE_TYPE=local
STORAGE_BASE_DIR=morphic-scan-data
OUTPUT_DIR=output

# --- S3/Cloudflare R2 (if using S3) ---
S3_ENDPOINT=https://your-bucket.s3.region.amazonaws.com
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_BUCKET=photogrammetry-data
S3_REGION=us-east-1
S3_PUBLIC_URL_BASE=https://your-bucket.s3.region.amazonaws.com

# --- Cloudinary (if using cloudinary) ---
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================
BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# --- CORS Configuration ---
# Add comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ============================================================================
# WORKER CONFIGURATION
# ============================================================================
# Strategy: push (Modal/cloud) or pull (Kaggle/local)
WORKER_STRATEGY=pull
WORKER_TOKEN=YOUR_SECURE_TOKEN_HERE_NOT_test-token-123

# --- Modal Configuration (for cloud GPU jobs) ---
MODAL_WORKSPACE=morphic
MODAL_APP_NAME=photogrammetry-worker
MODAL_FUNCTION_NAME=run_colmap_job
MODAL_TOKEN_ID=YOUR_MODAL_TOKEN_ID
MODAL_TOKEN_SECRET=YOUR_MODAL_TOKEN_SECRET

# --- Ngrok Configuration (for local tunneling) ---
NGROK_AUTHTOKEN=YOUR_NGROK_AUTH_TOKEN

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_DENSE=True
ENABLE_SPLAT=False
SPLAT_MAX_POINTS=500000
SPLAT_ITERATIONS=10000

# ============================================================================
# RESOURCE GOVERNANCE
# ============================================================================
MAX_UPLOAD_SIZE=500000000
MAX_IMAGES_PER_JOB=1000
MIN_IMAGES_PER_JOB=3
FRAME_EXTRACTION_FPS=10
MAX_GPU_MINUTES=30
MAX_STORAGE_GB=1.0

# ============================================================================
# JOB CONTROL
# ============================================================================
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=60

# ============================================================================
# OBSERVABILITY
# ============================================================================
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit real credentials to version control
# 2. Use a secrets manager in production (AWS Secrets Manager, HashiCorp Vault, etc.)
# 3. Rotate credentials regularly
# 4. Use strong tokens (not "test-token-123")
# 5. Restrict database access to application servers only
# 6. Enable SSL/TLS for all external communications
# 7. Use separate credentials for each environment (dev, staging, prod)
